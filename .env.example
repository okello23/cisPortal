APP_NAME="CPHL ICT Support Portal"
APP_ENV=local
APP_KEY=base64:kHUa8mX7kxU7/R62sVMdJpd3rwA2BTrPa0/4GEWK6u4=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cis_portal
DB_USERNAME=cis_user
DB_PASSWORD=change_this

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ictsupport@cphl.go.ug"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_SERVER_HOST=
BACKUP_SERVER_PORT=868
BACKUP_SERVER_USER=cis-backup-admin
BACKUP_SERVER_ROOT=/backup/dumps
BACKUP_SSH_IDENTITY_FILE="~/.ssh/cis_backup_deploy"
BACKUP_AUTHORIZED_KEYS_PATH=/home/backupuser/.ssh/authorized_keys
BACKUP_AUTHORIZED_KEYS_OWNER=backupuser
BACKUP_AUTHORIZED_KEYS_GROUP=backupuser
BACKUP_AUTHORIZED_KEYS_MODE=600
BACKUP_REMOTE_TEMP_PATH=/tmp/authorized_keys.generated
BACKUP_INSTALL_COMMAND="sudo /usr/local/bin/install_alis_authorized_keys.sh"
BACKUP_DEPLOY_TIMEOUT=30
ALIS_BACKUP_ALLOW_RSA=false

VITE_APP_NAME="${APP_NAME}"
